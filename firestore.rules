rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDriver() {
      return signedIn() && request.auth.token.role == 'driver';
    }

    function isCustomer() {
      return signedIn() && request.auth.token.role == 'customer';
    }

    match /partners/{partnerId} {
      allow read: if signedIn() && (request.auth.uid == partnerId || isCustomer());
      allow create, update: if isDriver() && request.auth.uid == partnerId;
      allow delete: if false;

      match /earnings/{earningId} {
        allow read: if isDriver() && request.auth.uid == partnerId;
        allow write: if false;
      }
    }

    match /bookings/{bookingId} {
      allow get: if signedIn() && (
        (isDriver() && (
          resource.data.partnerId == request.auth.uid ||
          resource.data.status in ['SEARCHING', 'REQUESTED']
        )) ||
        (isCustomer() && resource.data.customerId == request.auth.uid)
      );

      // Only partner clients may enumerate the live booking queue. Individual
      // customer reads remain restricted to the owning customer via get above.
      allow list: if isDriver();

      allow create: if isCustomer() && request.resource.data.customerId == request.auth.uid;

      // Driver booking transitions are server-only through callable functions.
      // Customers may update only their own cancellation metadata.
      allow update: if isCustomer()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'cancelledAt'
        ]);

      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if isDriver() && request.resource.data.userId == request.auth.uid;
      allow read: if isDriver() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /profiles/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
