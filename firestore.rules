rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isDriver() { return signedIn() && request.auth.token.role == 'driver'; }
    function isCustomer() { return signedIn() && request.auth.token.role == 'customer'; }

    match /partners/{partnerId} {
      allow read: if signedIn() && (request.auth.uid == partnerId || isCustomer());
      allow create, update: if isDriver() && request.auth.uid == partnerId;
      allow delete: if false;

      match /earnings/{earningId} {
        allow read: if isDriver() && request.auth.uid == partnerId;
        allow write: if false;
      }

      match /withdrawals/{withdrawalId} {
        allow read: if isDriver() && request.auth.uid == partnerId;
        allow write: if false;
      }
    }

    match /payoutRequests/{payoutId} {
      allow read: if isDriver() && resource.data.partnerId == request.auth.uid;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow get: if signedIn() && (
        (isDriver() && (
          resource.data.partnerId == request.auth.uid ||
          resource.data.status in ['SEARCHING', 'REQUESTED']
        )) ||
        (isCustomer() && resource.data.customerId == request.auth.uid)
      );
      allow list: if isDriver();
      allow create: if isCustomer() && request.resource.data.customerId == request.auth.uid;
      allow update: if isCustomer()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'cancelledAt'
        ]);
      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if isDriver() && request.resource.data.userId == request.auth.uid;
      allow read: if isDriver() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /profiles/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
