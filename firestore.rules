rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function appChecked() {
      return request.app != null;
    }

    function signedIn() {
      return appChecked() && request.auth != null;
    }

    function isCustomer() {
      return signedIn() && request.auth.token.role == 'customer';
    }

    function isDriver() {
      return signedIn() && request.auth.token.role == 'driver';
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    match /partners/{partnerId} {
      allow read: if signedIn() && request.auth.uid == partnerId;
      allow create: if false;
      allow update: if signedIn()
        && request.auth.uid == partnerId
        && request.resource.data.uid == partnerId
        && request.resource.data.role == resource.data.role
        && request.resource.data.role in ['driver', 'partner_candidate']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'fullName',
          'city',
          'drivingExperience',
          'bankAccountNo',
          'ifscCode',
          'accountHolder',
          'bankUpdatedTime',
          'licenseDocumentUrl',
          'licenseDocumentStatus',
          'governmentIdDocumentUrl',
          'governmentIdDocumentStatus',
          'updatedAt'
        ])
        && (!('licenseDocumentStatus' in request.resource.data) || request.resource.data.licenseDocumentStatus in ['SUBMITTED', 'REUPLOAD_REQUIRED', 'Approved', 'APPROVED'])
        && (!('governmentIdDocumentStatus' in request.resource.data) || request.resource.data.governmentIdDocumentStatus in ['SUBMITTED', 'REUPLOAD_REQUIRED', 'Approved', 'APPROVED']);
      allow delete: if false;

      match /earnings/{earningId} {
        allow read: if isDriver() && request.auth.uid == partnerId;
        allow write: if false;
      }

      match /withdrawals/{withdrawalId} {
        allow read: if isDriver() && request.auth.uid == partnerId;
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'driver';

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'phone',
          'phoneNumber',
          'photoUrl',
          'updatedAt',
          'createdAt',
          'role'
        ]);

      allow delete: if false;
    }

    match /payoutRequests/{payoutId} {
      allow read: if isDriver() && resource.data.partnerId == request.auth.uid;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow get: if signedIn() && (
        (isCustomer() && resource.data.customerId == request.auth.uid) ||
        (isDriver() && (
          resource.data.partnerId == request.auth.uid ||
          resource.data.status in ['SEARCHING', 'REQUESTED', 'searching', 'requested']
        )) ||
        isAdmin()
      );

      allow list: if signedIn() && (
        (isCustomer() && resource.data.customerId == request.auth.uid) ||
        (isDriver() && (
          resource.data.partnerId == request.auth.uid ||
          resource.data.status in ['SEARCHING', 'REQUESTED', 'searching', 'requested']
        )) ||
        isAdmin()
      );

      allow create: if isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.bookingId == bookingId
        && request.resource.data.status in ['SEARCHING', 'REQUESTED', 'searching', 'requested']
        && (!('bookingStatus' in request.resource.data) || request.resource.data.bookingStatus in ['SEARCHING', 'REQUESTED', 'searching', 'requested'])
        && (!('partnerId' in request.resource.data) || request.resource.data.partnerId == null)
        && (!('driverId' in request.resource.data) || request.resource.data.driverId == null)
        && request.resource.data.fare is number
        && request.resource.data.fare >= 0
        && request.resource.data.paymentMethod in ['UPI', 'Card', 'Cash']
        && request.resource.data.paymentStatus in ['pending', 'paid'];

      allow update: if isCustomer()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId
        && resource.data.status in ['SEARCHING', 'REQUESTED', 'searching', 'requested',
          'ACCEPTED', 'ARRIVING', 'ARRIVED', 'accepted', 'arriving', 'arrived']
        && resource.data.bookingStatus in ['SEARCHING', 'REQUESTED', 'searching', 'requested',
          'ACCEPTED', 'ARRIVING', 'ARRIVED', 'accepted', 'arriving', 'arrived']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'bookingStatus',
          'updatedAt',
          'cancelledAt',
          'cancelledBy',
          'cancellationReason'
        ])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.bookingStatus == 'cancelled';

      allow update: if isDriver()
        && resource.data.partnerId == request.auth.uid
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'bookingStatus',
          'updatedAt',
          'preTripFrontUrl',
          'preTripBackUrl',
          'preTripRightUrl',
          'preTripLeftUrl',
          'driverSelfieUrl',
          'postTripFrontUrl',
          'postTripBackUrl',
          'postTripRightUrl',
          'postTripLeftUrl'
        ])
        && request.resource.data.status in [
          'accepted', 'arriving', 'arrived', 'in_progress', 'completed',
          'ACCEPTED', 'ARRIVING', 'ARRIVED', 'TRIP_STARTED', 'COMPLETED'
        ];

      allow update: if isAdmin()
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'bookingStatus',
          'updatedAt',
          'driverId',
          'partnerId',
          'driverName',
          'driverPhone',
          'vehicle'
        ]);

      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if isDriver() && request.resource.data.userId == request.auth.uid;
      allow read: if isDriver() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'driver';

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'phoneNumber',
          'photoUrl',
          'updatedAt',
          'createdAt',
          'role'
        ]);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
