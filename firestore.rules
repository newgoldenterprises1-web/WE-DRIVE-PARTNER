rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDriver() {
      return signedIn() && request.auth.token.role == 'driver';
    }

    function isCustomer() {
      return signedIn() && request.auth.token.role == 'customer';
    }

    function driverOwnsBooking() {
      return isDriver() && resource.data.partnerId == request.auth.uid;
    }

    function validDriverTransition() {
      return isDriver() && resource.data.partnerId == request.auth.uid && (
        (resource.data.status == 'ACCEPTED' && request.resource.data.status == 'ARRIVING') ||
        (resource.data.status == 'ARRIVING' && request.resource.data.status == 'ARRIVED') ||
        (resource.data.status == 'ARRIVED' && request.resource.data.status == 'TRIP_STARTED') ||
        (resource.data.status == 'TRIP_STARTED' && request.resource.data.status == 'COMPLETED')
      );
    }

    match /partners/{partnerId} {
      allow read: if signedIn() && (request.auth.uid == partnerId || isCustomer());
      allow create, update: if isDriver() && request.auth.uid == partnerId;
      allow delete: if false;

      match /earnings/{earningId} {
        allow read: if isDriver() && request.auth.uid == partnerId;
        allow write: if false;
      }
    }

    match /bookings/{bookingId} {
      // Drivers can see unassigned incoming requests and their own assigned rides.
      // Customers can see only their own bookings.
      allow get: if signedIn() && (
        (isDriver() && (
          resource.data.partnerId == request.auth.uid ||
          resource.data.status in ['SEARCHING', 'REQUESTED']
        )) ||
        (isCustomer() && resource.data.customerId == request.auth.uid)
      );

      allow list: if signedIn();

      // Only customers create bookings. Driver assignment is server-side.
      allow create: if isCustomer() && request.resource.data.customerId == request.auth.uid;

      // Driver status changes are tightly limited to the assigned booking.
      // ACCEPTED/CANCELLED assignment is performed by callable backend functions.
      allow update: if validDriverTransition()
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.fare == resource.data.fare
      || (
        isCustomer() &&
        resource.data.customerId == request.auth.uid
      );

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /profiles/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
