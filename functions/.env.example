# WE DRIVE AI backend gateway
# Set the real value in Firebase Functions environment configuration; never commit the real token.
WE_DRIVE_AI_GATEWAY_TOKEN=replace-with-a-long-random-service-token

# Development Agent (server-side only)
GITHUB_TOKEN=replace-with-github-token
# Marketing integrations (server-side only)
META_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=replace-with-meta-token
META_PAGE_ACCESS_TOKEN=replace-with-page-token
META_PAGE_ID=replace-with-page-id
META_IG_USER_ID=replace-with-instagram-user-id
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
