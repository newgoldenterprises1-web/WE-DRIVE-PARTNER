rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isPartner() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/partners/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    function ownsBooking(bookingId) {
      return isPartner()
        && firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.partnerId == request.auth.uid;
    }

    match /inspections/{bookingId}/{folder}/{fileName} {
      allow read: if ownsBooking(bookingId);

      allow create, update: if ownsBooking(bookingId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if ownsBooking(bookingId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
