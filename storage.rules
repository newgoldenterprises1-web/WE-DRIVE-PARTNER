rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.app != null && request.auth != null; }
    function isDriver() { return signedIn() && request.auth.token.role == 'driver'; }
    function ownsBooking(uid, bookingId) {
      return isDriver()
        && uid == request.auth.uid
        && firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.partnerId == request.auth.uid;
    }

    match /inspections/{uid}/{bookingId}/{folder}/{fileName} {
      allow read: if ownsBooking(uid, bookingId);
      allow create, update: if ownsBooking(uid, bookingId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
